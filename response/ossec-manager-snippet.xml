<!-- Add inside the <ossec_config> of the WAZUH MANAGER's /var/ossec/etc/ossec.conf -->

<!-- 1. Declare the command (the executable deployed on the agent) -->
<command>
  <name>disable-ad-account</name>
  <executable>disable-ad-account.cmd</executable>
  <timeout_allowed>no</timeout_allowed>
</command>

<!-- 2. Bind it to ONE rule only: DCSync (100514). location "local" runs it on the
        agent (DC01) that produced the alert, where the AD cmdlets live.
        AS-REP (100510), Kerberoast (100511/100512) and spraying (100515) are
        deliberately NOT bound: they do not identify a single compromised account,
        so they stay alert-only until an analyst reviews them. The script also
        enforces this allow-list itself, so editing this XML cannot widen it. -->
<active-response>
  <command>disable-ad-account</command>
  <location>local</location>
  <rules_id>100514</rules_id>
</active-response>

# systemd unit for the live AD anomaly scoring service (ADVISORY ONLY).
# Install:  sudo cp deploy/adserve.service /etc/systemd/system/
#           sudo install -d -o adserve -g wazuh -m 0750 /var/log/adserve
#           sudo systemctl daemon-reload && sudo systemctl enable --now adserve
# Logs:     journalctl -u adserve -f
#
# Put the trusted model hash in a root-owned drop-in, NOT in the bundle:
#   sudo systemctl edit adserve   ->  [Service]\nEnvironment=ADSERVE_MODEL_SHA256=<sha256 of model.pt>
[Unit]
Description=adserve - live AD anomaly scoring (Wazuh -> sequence model)
After=wazuh-manager.service
Wants=wazuh-manager.service

[Service]
Type=simple
User=adserve
Group=wazuh
WorkingDirectory=/opt/ad-threat-detection/serve
# admodel is a fixed, root-owned install location - never taken from the model bundle.
Environment=PYTHONPATH=/opt/ad-threat-detection/models
Environment=ADSERVE_BUNDLE_DIR=/opt/ad-threat-detection/serve/serve_bundle
Environment=ADSERVE_ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
# Dedicated output dir: the service can no longer write inside /var/ossec/logs.
Environment=ADSERVE_OUT_PATH=/var/log/adserve/ml_anomalies.json
Environment=ADSERVE_DEVICE=cpu
ExecStart=/opt/ad-threat-detection/serve/.venv/bin/python -m adserve.service
Restart=on-failure
RestartSec=5

# --- Hardening ---------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0027
ReadOnlyPaths=/var/ossec/logs/alerts /opt/ad-threat-detection
ReadWritePaths=/var/log/adserve
MemoryMax=2G

[Install]
WantedBy=multi-user.target

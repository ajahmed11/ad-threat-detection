<!--
  Surface adserve's anomalies in Wazuh AS ALERTS FOR ANALYSTS. The ML service is
  advisory: its records contain no Windows account fields, so they cannot (and
  must not) drive Disable-ADAccount. Containment stays tied to validated rule
  detections only (see response/).

  1) Add this <localfile> inside <ossec_config> on the manager.
     (Path matches the service's dedicated output dir - /var/log/adserve.)
-->
<localfile>
  <log_format>json</log_format>
  <location>/var/log/adserve/ml_anomalies.json</location>
</localfile>

<!--
  2) Rules that lift the JSON fields. Put in etc/rules/local_rules.xml.
     Adjust the rule id range to one free in your deployment.
-->
<!--
